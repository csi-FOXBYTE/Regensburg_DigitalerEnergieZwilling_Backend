@startuml
title Ablauf: Öffentliche Löschung

actor Benutzer
participant "Öffentlicher Client" as client
participant "APISIX (Web-/API-Gateway)" as gateway
participant "Backend-API" as api
participant "Nutzerdatendienst" as uds
database "Datenbank" as db

Benutzer -> client : Löschlink/QR-Code öffnen
client -> gateway : GET /delete/{token}
gateway -> api : Anfrage weiterleiten
api -> uds : Token validieren
uds -> db : Datensatz suchen
db --> uds : Datensatz oder nicht gefunden
uds --> api : Gültig/ungültig
api --> gateway : Bestätigung oder Fehler anzeigen
gateway --> client : Bestätigung oder Fehler anzeigen

alt Bestätigt
  client -> gateway : POST /delete/{token}\nAdressbestätigung
  gateway -> api : Anfrage weiterleiten
  api -> uds : Löschanfrage
  uds -> db : Adresse prüfen\nund Datensatz löschen
  db --> uds : Gelöscht
  uds --> api : Erfolgreich
  api --> gateway : Bestätigung
  gateway --> client : Bestätigung
else Ungültig
  api --> gateway : Fehler (Token/Adresse)
  gateway --> client : Fehler (Token/Adresse)
end

@enduml
